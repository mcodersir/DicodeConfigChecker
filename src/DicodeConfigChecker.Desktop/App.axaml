<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Dicode.ConfigChecker.Desktop.App" RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <Style Selector="Window"><Setter Property="FontFamily" Value="avares://DicodeConfigChecker.Desktop/Assets/Fonts#Vazirmatn, Inter, Segoe UI"/><Setter Property="Background" Value="{DynamicResource ApplicationPageBackgroundThemeBrush}"/></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="14,9"/></Style>
    <Style Selector="TextBox"><Setter Property="CornerRadius" Value="9"/></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Padding" Value="18"/></Style>
    <Style Selector="TextBlock.title"><Setter Property="FontSize" Value="22"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/></Style>
    <Style Selector="Button.nav"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Margin" Value="0,2"/></Style>
  </Application.Styles>
</Application>
