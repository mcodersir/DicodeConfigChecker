<Window x:Class="Dicode.ConfigChecker.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dicode Config Checker 2" Width="1080" Height="720" MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterScreen" Background="{StaticResource PageBrush}"
        FontFamily="Segoe UI" FlowDirection="RightToLeft">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Dicode Config Checker" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock Text="نسخه ۲ • سنجش واقعی و سریع اتصال" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#E9F0FF" CornerRadius="18" Padding="14,7" VerticalAlignment="Center">
        <TextBlock x:Name="RuntimeStatus" Text="در حال بررسی هسته‌ها…" Foreground="{StaticResource AccentBrush}"/>
      </Border>
    </Grid>
    <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
      <TabItem Header="داشبورد">
        <Grid Margin="0,18,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="کانال‌های عمومی" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
              <TextBox x:Name="ChannelsBox" Grid.Row="1" Margin="0,12,0,12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" FlowDirection="LeftToRight"/>
              <ProgressBar x:Name="RunProgress" Grid.Row="2" Height="7" Minimum="0" Maximum="100" Value="0"/>
              <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="آماده" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="CancelButton" Grid.Column="1" Content="توقف" Background="#E7EBF2" Foreground="#334155" IsEnabled="False" Click="Cancel_Click"/>
                <Button x:Name="StartButton" Grid.Column="3" Content="شروع بررسی" Click="Start_Click"/>
              </Grid>
            </Grid>
          </Border>
          <StackPanel Grid.Column="2">
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,12">
              <StackPanel><TextBlock Text="نتیجه آخر" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="AliveText" Text="—" FontWeight="Bold" FontSize="34" Foreground="#159A68" Margin="0,10,0,0"/><TextBlock Text="کانفیگ سالم" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </Border>
            <Border Background="{StaticResource CardBrush}" CornerRadius="16" Padding="20" Margin="0,0,0,12">
              <StackPanel><TextBlock Text="تاخیر برتر" FontWeight="SemiBold" FontSize="17"/><TextBlock x:Name="BestText" Text="—" FontWeight="Bold" FontSize="34" Foreground="{StaticResource AccentBrush}" Margin="0,10,0,0"/><TextBlock Text="میلی‌ثانیه، درخواست واقعی" Foreground="{StaticResource MutedBrush}"/></StackPanel>
            </Border>
            <Button Content="باز کردن پوشه خروجی" Click="OpenOutput_Click"/>
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="نتایج">
        <Border Margin="0,18,0,0" Background="White" CornerRadius="16" Padding="14">
          <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column" FlowDirection="RightToLeft">
            <DataGrid.Columns>
              <DataGridTextColumn Header="وضعیت" Binding="{Binding Status}" Width="90"/>
              <DataGridTextColumn Header="پروتکل" Binding="{Binding Protocol}" Width="110"/>
              <DataGridTextColumn Header="آدرس" Binding="{Binding Address}" Width="*"/>
              <DataGridTextColumn Header="Median" Binding="{Binding Median}" Width="100"/>
              <DataGridTextColumn Header="Min" Binding="{Binding Minimum}" Width="90"/>
              <DataGridTextColumn Header="موفق" Binding="{Binding Success}" Width="90"/>
              <DataGridTextColumn Header="روش" Binding="{Binding Tester}" Width="130"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </TabItem>
      <TabItem Header="تنظیمات">
        <Border Margin="0,18,0,0" Background="White" CornerRadius="16" Padding="24" MaxWidth="700" HorizontalAlignment="Right">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="آدرس تست واقعی" VerticalAlignment="Center"/><TextBox x:Name="TestUrlBox" Grid.Column="1" Text="https://www.gstatic.com/generate_204" FlowDirection="LeftToRight"/>
            <TextBlock Grid.Row="1" Text="تعداد تلاش" Margin="0,18,0,0" VerticalAlignment="Center"/><TextBox x:Name="AttemptsBox" Grid.Row="1" Grid.Column="1" Text="2" Margin="0,18,0,0"/>
            <TextBlock Grid.Row="2" Text="اندازه هر batch" Margin="0,18,0,0" VerticalAlignment="Center"/><TextBox x:Name="PageSizeBox" Grid.Row="2" Grid.Column="1" Text="32" Margin="0,18,0,0"/>
            <TextBlock Grid.Row="3" Text="پردازش موازی" Margin="0,18,0,0" VerticalAlignment="Center"/><TextBox x:Name="WorkersBox" Grid.Row="3" Grid.Column="1" Text="16" Margin="0,18,0,0"/>
            <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Margin="0,24,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="هر batch با یک پردازش هسته و SOCKS مستقل برای هر کانفیگ اجرا می‌شود. شکست‌ها یک بار جداگانه بازآزمایی می‌شوند."/>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
